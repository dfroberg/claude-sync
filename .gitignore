.sync.lock.d/

# Local push-pending flag. Machine-local state, never shared: syncing it would make the
# other machine think it has unsynced work. It normally does not exist by the time
# `add -A` runs (the timer clears it first), but a write landing mid-push re-creates it
# -- which is exactly the race the re-flag logic depends on.
.dirty

# Local push log; noisy, machine-specific, and plaintext in a public repo.
last-sync.log

# The rewrite's local state, all at the repo root. Anchored so the same names under
# data/ still sync; only the temporary files of atomic writes are ignored at any depth.
/.sync.lock
/.fresh-machine
/conflicts/
/trash/
/claude_sync/__pycache__/
/tests/__pycache__/
*.sync-tmp.*
/last-sync.log.1
/.hold-*

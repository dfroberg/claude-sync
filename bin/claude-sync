#!/usr/bin/env bash
# claude-sync — sync ~/.claude memories/settings/skills across machines via a
# git-crypt-encrypted git repo, with user/path canonicalization.
#
# The repo stores a curated ALLOWLIST (never transcripts/caches/plugins/auth).
# Paths are canonicalized to a __USER__ sentinel on push and rehydrated to the
# local user on pull, so dfroberg and dannyfroberg are the same person.
#
#   claude-sync push      collect ~/.claude -> repo, commit, push
#   claude-sync pull      pull repo -> apply into ~/.claude
#   claude-sync dry-run   collect only (no git); print what would sync
#   claude-sync status    git status of the sync repo
set -euo pipefail

REPO="${CLAUDE_SYNC_REPO:-$HOME/.claude-sync}"
CLAUDE="$HOME/.claude"
DATA="$REPO/data"
TOKEN="__USER__"
ME="$(id -un)"
BRANCH="${CLAUDE_SYNC_BRANCH:-main}"
LOCKDIR="$REPO/.sync.lock.d"

log(){ printf '[claude-sync] %s\n' "$*" >&2; }
die(){ log "ERROR: $*"; exit 1; }

# Recursion guard. memory-reconcile shells out to `claude`, and this script runs FROM
# SessionStart/SessionEnd hooks -- so a nested session that ran hooks would re-enter here
# forever. memory-reconcile passes --settings '{"disableAllHooks":true}', which should make
# that impossible; this is the independent second line of defence in case it ever does not.
[ "${CLAUDE_SYNC_RECONCILING:-0}" = "1" ] && { log "nested invocation; skipping"; exit 0; }

RECONCILE="$REPO/bin/memory-reconcile"

# Bring every project's MEMORY.md back in line with its files. $1, if given, is a directory
# of pre-apply MEMORY.md snapshots keyed by project, used to recover entries the apply
# overwrote. Never fatal: a broken index is worth fixing, never worth failing a sync over.
reconcile_indexes(){
  [ -x "$RECONCILE" ] || return 0
  [ "${CLAUDE_SYNC_NO_RECONCILE:-0}" = "1" ] && return 0
  snaps="${1:-}"
  # Whole-pass budget. Each project is individually bounded, but 15 projects still add up,
  # and sync is called from a SessionEnd hook with a 45s timeout of its own -- a slow
  # reconcile must never be what stops memories being pushed.
  deadline=$(( $(date +%s) + ${CLAUDE_SYNC_RECONCILE_BUDGET:-240} ))
  for m in "$CLAUDE"/projects/*/memory; do
    [ -d "$m" ] || continue
    if [ "$(date +%s)" -ge "$deadline" ]; then
      log "reconcile budget spent; remaining projects deferred to the next sync"
      return 0
    fi
    proj="$(basename "$(dirname "$m")")"
    prev=""
    [ -n "$snaps" ] && [ -f "$snaps/$proj/MEMORY.md" ] && prev="$snaps/$proj/MEMORY.md"
    "$RECONCILE" "$m" $prev || true
  done
}

# ---- allowlist (relative to ~/.claude). Memories handled specially below. ----
FILES=(CLAUDE.md settings.json mcp_settings.json keybindings.json)
DIRS=(skills agents commands hooks)

# Only rewrite paths inside text files; copy everything else verbatim.
is_text(){ case "$1" in *.md|*.json|*.jsonl|*.txt|*.sh|*.bash|*.zsh|*.lua|*.toml|*.yaml|*.yml|*.cfg) return 0;; *) return 1;; esac; }

# Mode must be carried explicitly. The text path writes with `sed > "$2"`, and a shell
# redirect only truncates an existing file -- it creates a NEW one at the umask default,
# 644. hooks/*.sh are text, so on a machine where the file already existed the mode was
# silently preserved and the bug stayed invisible, while a machine applying them for the
# first time got 644 and every hook died with "Permission denied". Seen on
# Dannys-MacBook-Pro 2026-07-27, right after its first bootstrap.
# git records only the exec bit, which is exactly the bit that matters here.
file_mode(){ stat -f '%Lp' "$1" 2>/dev/null || stat -c '%a' "$1" 2>/dev/null; }
copy_mode(){ m=$(file_mode "$1"); [ -n "$m" ] && chmod "$m" "$2" 2>/dev/null || true; }

canon_file(){   if is_text "$1"; then sed "s|/Users/$ME/|/Users/$TOKEN/|g; s|-Users-$ME-|-Users-$TOKEN-|g" "$1" >"$2"; else cp -p "$1" "$2"; fi; copy_mode "$1" "$2"; }
decanon_file(){ if is_text "$1"; then sed "s|/Users/$TOKEN/|/Users/$ME/|g; s|-Users-$TOKEN-|-Users-$ME-|g" "$1" >"$2"; else cp -p "$1" "$2"; fi; copy_mode "$1" "$2"; }

acquire_lock(){ mkdir "$LOCKDIR" 2>/dev/null || { log "another sync is running; skipping"; exit 0; }; trap 'rmdir "$LOCKDIR" 2>/dev/null || true' EXIT; }

# ~/.claude -> data/ (canonicalized). Rebuilds data/ from scratch each time.
collect(){
  rm -rf "$DATA"; mkdir -p "$DATA"
  for f in "${FILES[@]}"; do
    [ -f "$CLAUDE/$f" ] || continue
    mkdir -p "$DATA/$(dirname "$f")"; canon_file "$CLAUDE/$f" "$DATA/$f"
  done
  for d in "${DIRS[@]}"; do
    [ -d "$CLAUDE/$d" ] || continue
    while IFS= read -r -d '' p; do
      rel="${p#"$CLAUDE"/}"; mkdir -p "$DATA/$(dirname "$rel")"; canon_file "$p" "$DATA/$rel"
    done < <(find "$CLAUDE/$d" -type f -print0)
  done
  # memories: ~/.claude/projects/<proj>/memory/**  ->  data/memory/<canonical-proj>/**
  for m in "$CLAUDE"/projects/*/memory; do
    [ -d "$m" ] || continue
    proj="$(basename "$(dirname "$m")")"
    cproj="${proj//-Users-$ME-/-Users-$TOKEN-}"
    while IFS= read -r -d '' p; do
      rel="${p#"$m"/}"; mkdir -p "$DATA/memory/$cproj/$(dirname "$rel")"; canon_file "$p" "$DATA/memory/$cproj/$rel"
    done < <(find "$m" -type f -print0)
  done
}

# data/ -> ~/.claude (decanonicalized). Additive merge — never deletes local files.
apply(){
  for f in "${FILES[@]}"; do
    [ -f "$DATA/$f" ] || continue
    mkdir -p "$CLAUDE/$(dirname "$f")"; decanon_file "$DATA/$f" "$CLAUDE/$f"
  done
  for d in "${DIRS[@]}"; do
    [ -d "$DATA/$d" ] || continue
    while IFS= read -r -d '' p; do
      rel="${p#"$DATA"/}"; mkdir -p "$CLAUDE/$(dirname "$rel")"; decanon_file "$p" "$CLAUDE/$rel"
    done < <(find "$DATA/$d" -type f -print0)
  done
  for cm in "$DATA"/memory/*; do
    [ -d "$cm" ] || continue
    cproj="$(basename "$cm")"
    proj="${cproj//-Users-$TOKEN-/-Users-$ME-}"
    dst="$CLAUDE/projects/$proj/memory"
    while IFS= read -r -d '' p; do
      rel="${p#"$cm"/}"; mkdir -p "$dst/$(dirname "$rel")"; decanon_file "$p" "$dst/$rel"
    done < <(find "$cm" -type f -print0)
  done
}

git_repo(){ [ -d "$REPO/.git" ] || die "no git repo at $REPO (bootstrap it first)"; }

# Auto-unlock git-crypt on a fresh clone: if data/ is still ciphertext and the
# sops-decrypted key exists (placed by dotnix decryptSecrets), unlock non-interactively.
KEYFILE="${CLAUDE_SYNC_KEY:-$HOME/.config/git-crypt/claude-sync.key}"
ensure_unlocked(){
  [ -f "$DATA/CLAUDE.md" ] || return 0
  head -c 12 "$DATA/CLAUDE.md" 2>/dev/null | grep -qa GITCRYPT || return 0   # already unlocked
  if [ -f "$KEYFILE" ]; then
    log "git-crypt locked; unlocking with $KEYFILE"
    ( cd "$REPO" && git-crypt unlock "$KEYFILE" ) 2>/dev/null || log "git-crypt unlock failed (bad key?)"
  else
    log "git-crypt locked and no key at $KEYFILE (run 'nud' to decrypt it, then retry)"
  fi
}

cmd_push(){
  acquire_lock; git_repo
  git -C "$REPO" pull --rebase --autostash origin "$BRANCH" 2>/dev/null || log "pull skipped (offline / no upstream yet)"
  ensure_unlocked

  # Fold in any orphans before collect, so the index this machine publishes is already
  # complete. Combined with the post-apply pass in cmd_pull, the index converges to the
  # union across machines without anyone having to merge markdown by hand.
  reconcile_indexes

  collect
  git -C "$REPO" add -A

  # Tripwire. collect() rebuilds data/ from THIS machine's ~/.claude with `rm -rf`, and
  # the pull above refreshes the repo WITHOUT applying anything into ~/.claude. So a
  # machine that is behind -- most dangerously one that has just cloned -- produces a
  # perfectly ordinary-looking commit that deletes everything the other machine owns.
  # Measured 2026-07-27 on a fresh clone against a 5-file home: 557 deletions, the whole
  # memory store plus every skill, agent and command. It then happened for real.
  #
  # Bulk deletion is therefore never assumed intentional. Real pruning says so explicitly:
  #   CLAUDE_SYNC_ALLOW_PRUNE=1 claude-sync push
  if [ "${CLAUDE_SYNC_ALLOW_PRUNE:-0}" != "1" ]; then
    dels=$(git -C "$REPO" diff --cached --diff-filter=D --name-only | wc -l | tr -d ' ')
    keep=$(git -C "$REPO" diff --cached --diff-filter=d --name-only | wc -l | tr -d ' ')
    if [ "$dels" -gt 20 ] && [ "$dels" -gt "$keep" ]; then
      log "REFUSING to push: would delete $dels files and keep only $keep."
      log "This machine looks out of date. Run 'claude-sync pull' first to apply the"
      log "remote into ~/.claude, verify your files, then push."
      log "If the deletion really is intended: CLAUDE_SYNC_ALLOW_PRUNE=1 claude-sync push"
      git -C "$REPO" reset -q
      return 1
    fi
  fi

  if git -C "$REPO" diff --cached --quiet; then
    log "no changes"
  else
    git -C "$REPO" commit -q -m "sync: $ME@$(scutil --get LocalHostName 2>/dev/null || hostname -s) $(date -u +%FT%TZ)"
  fi

  # Push whenever the branch is ahead, NOT only when this run produced a commit.
  # "no changes" used to return here, before the push -- so a commit stranded by an
  # earlier failed push was never retried by any later run. Observed 2026-07-27: three
  # commits, oldest 36h, all absent from the remote while every run reported success.
  ahead=$(git -C "$REPO" rev-list --count "@{u}..HEAD" 2>/dev/null || echo 0)
  if [ "$ahead" -eq 0 ]; then log "up to date"; return 0; fi

  if git -C "$REPO" push -q origin "$BRANCH" 2>/dev/null; then
    log "pushed ($ahead commit(s))"
  else
    # Propagate the failure. The old `push && log || log` always evaluated to 0, so the
    # timer wrapper's "re-flag and retry" branch was unreachable dead code.
    log "push failed (offline?) — $ahead commit(s) queued locally"
    return 1
  fi
}

cmd_pull(){
  acquire_lock; git_repo
  git -C "$REPO" pull --rebase --autostash origin "$BRANCH" 2>/dev/null || { log "pull skipped (offline?)"; return 0; }
  ensure_unlocked

  # Snapshot every MEMORY.md BEFORE apply overwrites it. apply is additive for memory
  # files but replaces the index outright, so without this the entries this machine added
  # since the last sync are simply gone -- the files stay, orphaned and invisible to future
  # sessions, because MEMORY.md is what actually loads.
  SNAPS=$(mktemp -d)
  for m in "$CLAUDE"/projects/*/memory; do
    [ -f "$m/MEMORY.md" ] || continue
    proj="$(basename "$(dirname "$m")")"
    mkdir -p "$SNAPS/$proj" && cp "$m/MEMORY.md" "$SNAPS/$proj/MEMORY.md"
  done

  [ -d "$DATA" ] && apply && log "applied" || log "nothing to apply"

  reconcile_indexes "$SNAPS"
  rm -rf "$SNAPS"
}

case "${1:-}" in
  push)          cmd_push;;
  pull)          cmd_pull;;
  status)        git_repo; git -C "$REPO" status -sb;;
  dry-run|dry)   collect; log "canonicalized into $DATA:"; find "$DATA" -type f | sed "s|$DATA/||" | sort;;
  *) echo "usage: claude-sync {push|pull|status|dry-run}"; exit 2;;
esac

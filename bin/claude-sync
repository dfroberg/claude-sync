#!/usr/bin/env bash
# claude-sync: sync ~/.claude memories/settings/skills across machines via a
# git-crypt-encrypted git repo. This file only picks a Python 3.9+ interpreter and runs
# the claude_sync package from the repo it lives in.
#
#   claude-sync pull      take remote changes into ~/.claude (three-way, never loses a local edit)
#   claude-sync push      collect ~/.claude into the repo, commit, push
#   claude-sync status    show the sync state
#   claude-sync dry-run   show what a push would send
#
# No `set -e`: every path ends in an explicit exit, and a hook must never break a session.

# launchd hands the push agent a bare PATH (/usr/bin:/bin:...). Apple git then runs the
# global git-lfs pre-push hook (core.hookspath) and cannot find git-lfs, which lives in the
# nix per-user profile, so every timer push failed with "failed to push some refs" -- 7
# pushes succeeded against 14952 failures in the log before this line. Same git, same
# ssh, same git-crypt as an interactive shell, whoever starts us.
for _p in /opt/homebrew/bin /run/current-system/sw/bin "$HOME/.nix-profile/bin" "/etc/profiles/per-user/$(id -un)/bin"; do  # last wins the front
  [ -d "$_p" ] && case ":$PATH:" in *":$_p:"*) ;; *) PATH="$_p:$PATH";; esac
done
export PATH

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)

# CLAUDE_SYNC_PYTHON, when set, is the only candidate (tests set it; a missing path tests the
# no-python branch below).
if [ -n "${CLAUDE_SYNC_PYTHON:-}" ]; then
  candidates=("$CLAUDE_SYNC_PYTHON")
else
  candidates=("/etc/profiles/per-user/$(id -un)/bin/python3"
              "$HOME/.nix-profile/bin/python3"
              "/run/current-system/sw/bin/python3"
              "/opt/homebrew/bin/python3")
  # /usr/bin/python3 is a stub that opens an install dialog without the command line tools.
  xcode-select -p >/dev/null 2>&1 && candidates+=("/usr/bin/python3")
fi

for py in "${candidates[@]}"; do
  [ -x "$py" ] || continue
  "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1 || continue
  # cd + -E -s -B: `-m` puts the current directory first on sys.path, so a json.py in a
  # hook's project directory would shadow the standard library.
  cd "$ROOT" && exec "$py" -E -s -B -m claude_sync "$@"
done

# No usable interpreter: leave a trace in the log, tell the session, and exit 0 so a hook
# never fails because of it.
printf '%s pid=%s %s ERROR no usable python3 (3.9 or newer) found\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$$" "${1:-?}" >> "${CLAUDE_SYNC_REPO:-$HOME/.claude-sync}/last-sync.log" 2>/dev/null || true
echo "claude-sync: ERROR no usable python3 found (see ~/.claude-sync/last-sync.log)"
exit 0
